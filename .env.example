# PCP AI Form Builder -- environment configuration example.
# Copy to `.env` and fill in real values. Never commit the real `.env`.

# --- App ---
APP_NAME=PCP AI Form Builder
APP_VERSION=0.1.0
DEBUG=false

# --- LLM provider selection ---
# One of: anthropic | azure_openai | openai | bedrock | ollama
LLM_PROVIDER=anthropic

# Bounded repair loop: how many repair attempts before giving up.
MAX_REPAIR_ATTEMPTS=2

# --- Anthropic / Claude (read only when LLM_PROVIDER=anthropic) ---
# Add ANTHROPIC_API_KEY to activate Claude. No code change needed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=8000

# --- Azure OpenAI (read only when LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- CORS (comma-separated allowed origins) ---
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,https://digi.punjab.gov.in
