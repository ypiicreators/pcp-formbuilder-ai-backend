# PCP AI Form Builder -- environment configuration example.
# Copy to `.env` and fill in real values. Never commit the real `.env`.

# --- App ---
APP_NAME=PCP AI Form Builder
APP_VERSION=0.1.0
DEBUG=false

# --- LLM provider selection ---
# One of: anthropic | azure_openai | openai | bedrock | ollama
LLM_PROVIDER=anthropic

# Bounded repair loop: how many repair attempts before giving up.
MAX_REPAIR_ATTEMPTS=2

# --- Anthropic / Claude (read only when LLM_PROVIDER=anthropic) ---
# Add ANTHROPIC_API_KEY to activate Claude. No code change needed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=8000
# One-shot spec enrich (table DOCX): skeleton + dependencies in a single call.
DOC_SPEC_ENRICH_MAX_TOKENS=24000

# --- Azure OpenAI (read only when LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- CORS (comma-separated allowed origins; NO trailing slash) ---
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,https://digi.punjab.gov.in,https://citizenserv.e-connectsolutions.com,https://pcppreprod.e-connectsolutions.com,https://pcp-dev.e-connectsolutions.com

# --- MongoDB (KB store) ---
# Leave MONGO_URI empty to run without Mongo. Format (URL-encode special chars in password):
# MONGO_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://yashashvi_db_user:pFm7FWTr0fvzw3tK@punjab-ai-backend.9mbh493.mongodb.net
MONGO_DB=Punjab-AI-Backend
# Use a separate database for tests so they never touch the real KB:
# MONGO_DB=pcp_form_ai_test
# KB_SEED_ON_EMPTY=true
# Set KB_SEED_ON_EMPTY=false after clearing Mongo KB collections to avoid auto re-seed.

# Workflow graph agent (independent of form-ai): POST /api/workflow-graph/message
